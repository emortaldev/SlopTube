{
  "manifest_version": 3,
  "name": "YouTube Redirect",
  "version": "1.1",
  "description": "Opens YouTube and YouTube Music links in your local apps (127.0.0.1 by default, configurable). Click the icon to toggle.",
  "browser_specific_settings": {
    "gecko": {
      "id": "sloptube@emortal.dev",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["none"] }
    },
    "gecko_android": { "strict_min_version": "142.0" }
  },
  "permissions": ["declarativeNetRequest", "storage"],
  "host_permissions": ["*://*.youtube.com/*", "*://youtu.be/*"],
  "background": { "service_worker": "background.js", "scripts": ["background.js"] },
  "action": { "default_title": "Redirect YouTube: on" },
  "options_ui": { "page": "options.html", "open_in_tab": false }
}
