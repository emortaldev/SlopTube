{
  "manifest_version": 3,
  "name": "YouTube → local apps",
  "version": "1.0",
  "description": "Opens YouTube and YouTube Music links in the local apps on 127.0.0.1. Click the icon to toggle.",
  "permissions": ["declarativeNetRequest"],
  "host_permissions": ["*://*.youtube.com/*", "*://youtu.be/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Redirect YouTube: on" },
  "declarative_net_request": {
    "rule_resources": [{ "id": "redirects", "enabled": true, "path": "rules.json" }]
  }
}
